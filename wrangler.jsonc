{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dailylogiclab",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/support/*"]
  },
  "vars": {
    "GA4_MEASUREMENT_ID": "G-6NY29HPM34",
    "STRIPE_ACCOUNT_ID": "acct_1ULzv5DxS18duIrJ",
    "STRIPE_PRICE_ID": "price_1UM0SHDxS18duIrJuHloaZEn",
    "SITE_ORIGIN": "https://dailylogiclab.com"
  },
  "durable_objects": { "bindings": [{ "name": "PAYMENT_ANALYTICS", "class_name": "PaymentAnalytics" }] },
  "migrations": [{ "tag": "v1-payment-analytics", "new_sqlite_classes": ["PaymentAnalytics"] }]
}
